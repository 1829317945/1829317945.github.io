<div class="post-like-section">
  <button id="post-like-btn" class="post-like-button">
    <i class="far fa-heart"></i>
    <span id="like-count" class="like-count">0</span>
  </button>
</div>

<script>
(function() {
  const likeBtn = document.getElementById('post-like-btn');
  const countSpan = document.getElementById('like-count');
  const heartIcon = likeBtn.querySelector('i');

  const pagePath = window.location.pathname.replace(/\//g, '_').replace(/index\.html$/, '');
  if (pagePath === '_' || pagePath === '') return;

  const namespace = 'songlin_blog_likes';
  const storageKey = 'liked_' + pagePath;
  const getUrl = 'https://api.countapi.xyz/get/' + namespace + '/' + pagePath;
  const hitUrl = 'https://api.countapi.xyz/hit/' + namespace + '/' + pagePath;

  // 页面加载时获取真实点赞数
  fetch(getUrl)
    .then(function(res) { return res.json(); })
    .then(function(data) {
      countSpan.innerText = data.value || 0;
    })
    .catch(function() {
      countSpan.innerText = 0;
    });

  // 恢复已点赞状态
  if (localStorage.getItem(storageKey)) {
    likeBtn.classList.add('is-liked');
    heartIcon.classList.replace('far', 'fas');
  }

  // 点击逻辑：只能点赞，不能取消
  likeBtn.onclick = function() {
    if (localStorage.getItem(storageKey)) return; // 已点赞，忽略

    likeBtn.classList.add('is-liked');
    heartIcon.classList.replace('far', 'fas');
    localStorage.setItem(storageKey, 'true');

    fetch(hitUrl)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        countSpan.innerText = data.value;
      })
      .catch(function(err) {
        console.error('Like failed:', err);
      });
  };
})();
</script>