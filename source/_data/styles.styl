/* Floating stardust particles */
.gate-particles {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.gate-particle {
  position: absolute;
  width: 3px;
  height: 3px;
  background: rgba(200, 210, 240, 0.7);
  border-radius: 50%;
  animation: float-up linear infinite;
}

.gate-particle:nth-child(1) { left: 10%; animation-duration: 12s; animation-delay: 0s; width: 2px; height: 2px; opacity: 0.6; }
.gate-particle:nth-child(2) { left: 25%; animation-duration: 15s; animation-delay: -3s; width: 3px; height: 3px; opacity: 0.5; }
.gate-particle:nth-child(3) { left: 40%; animation-duration: 10s; animation-delay: -7s; width: 2px; height: 2px; opacity: 0.7; }
.gate-particle:nth-child(4) { left: 55%; animation-duration: 14s; animation-delay: -2s; width: 4px; height: 4px; opacity: 0.4; }
.gate-particle:nth-child(5) { left: 70%; animation-duration: 11s; animation-delay: -5s; width: 2px; height: 2px; opacity: 0.6; }
.gate-particle:nth-child(6) { left: 85%; animation-duration: 13s; animation-delay: -9s; width: 3px; height: 3px; opacity: 0.5; }
.gate-particle:nth-child(7) { left: 18%; animation-duration: 16s; animation-delay: -4s; width: 2px; height: 2px; opacity: 0.4; }
.gate-particle:nth-child(8) { left: 62%; animation-duration:  9s; animation-delay: -6s; width: 3px; height: 3px; opacity: 0.7; }

@keyframes float-up {
  0%   { transform: translateY(110vh) scale(0); opacity: 0; }
  10%  { opacity: 0.8; }
  90%  { opacity: 0.2; }
  100% { transform: translateY(-10vh) scale(1.5); opacity: 0; }
}

/* Portal ring */
.gate-portal-ring {
  position: absolute;
  width: 420px;
  height: 420px;
  border-radius: 50%;
  border: 1px solid rgba(200, 170, 100, 0.2);
  box-shadow:
    0 0 60px rgba(180, 140, 60, 0.08),
    0 0 120px rgba(180, 140, 60, 0.04),
    inset 0 0 60px rgba(180, 140, 60, 0.04);
  z-index: 1;
  animation: portal-pulse 6s ease-in-out infinite;
  pointer-events: none;
}

.gate-portal-ring::before {
  content: '';
  position: absolute;
  top: -2px;
  left: -2px;
  right: -2px;
  bottom: -2px;
  border-radius: 50%;
  border: 1px solid transparent;
  background: conic-gradient(from 0deg, transparent, rgba(200, 170, 100, 0.15), transparent, rgba(200, 170, 100, 0.08), transparent) border-box;
  -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
  mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  animation: portal-rotate 20s linear infinite;
}

@keyframes portal-pulse {
  0%, 100% { box-shadow: 0 0 60px rgba(180, 140, 60, 0.08), 0 0 120px rgba(180, 140, 60, 0.04), inset 0 0 60px rgba(180, 140, 60, 0.04); }
  50%      { box-shadow: 0 0 90px rgba(200, 160, 80, 0.14), 0 0 160px rgba(200, 160, 80, 0.06), inset 0 0 80px rgba(200, 160, 80, 0.06); }
}

@keyframes portal-rotate {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

/* Content container */
.gate-container {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 500px;
  width: 86%;
  padding: 50px 36px 44px;
}

/* Constellation symbol replacing the chop/seal */
.gate-constellation {
  margin-bottom: 32px;
  position: relative;
  width: 60px;
  height: 60px;
}

.gate-constellation::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 8px;
  height: 8px;
  background: #e8c56d;
  border-radius: 50%;
  box-shadow: 0 0 16px rgba(232, 197, 109, 0.8), 0 0 32px rgba(232, 197, 109, 0.4);
}

/* Star lines connecting to center */
.gate-constellation::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 50px;
  height: 50px;
  transform: translate(-50%, -50%);
  background:
    radial-gradient(2px 2px at  0%  30%, rgba(200,180,140,0.8) 50%, transparent 50%),
    radial-gradient(2px 2px at 100% 25%, rgba(200,180,140,0.7) 50%, transparent 50%),
    radial-gradient(2px 2px at 30%  90%, rgba(200,180,140,0.9) 50%, transparent 50%),
    radial-gradient(2px 2px at 75%  85%, rgba(200,180,140,0.6) 50%, transparent 50%),
    radial-gradient(2px 2px at 15%  60%, rgba(200,180,140,0.5) 50%, transparent 50%),
    radial-gradient(2px 2px at 85%  60%, rgba(200,180,140,0.7) 50%, transparent 50%);
  animation: twinkle-medium 3s ease-in-out infinite;
}

.gate-question-area {
  text-align: center;
  margin-bottom: 32px;
}

.gate-question-text {
  font-size: 22px;
  line-height: 1.7;
  color: #e8c56d;
  letter-spacing: 3px;
  font-family: "Noto Serif SC", "KaiTi", "STKaiti", serif;
  text-shadow: 0 0 30px rgba(232, 197, 109, 0.4), 0 0 60px rgba(232, 197, 109, 0.15);
}

.gate-input-area {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 22px;
  position: relative;
  z-index: 3;
}

.gate-input {
  width: 160px;
  height: 48px;
  border: 1px solid rgba(200, 170, 100, 0.4);
  background: rgba(10, 15, 40, 0.7);
  border-radius: 24px;
  text-align: center;
  font-size: 20px;
  font-family: "Noto Serif SC", "KaiTi", serif;
  color: #e8c56d;
  outline: none;
  transition: border-color 0.3s, box-shadow 0.3s;
  letter-spacing: 6px;
  backdrop-filter: blur(6px);
}

.gate-input::placeholder {
  color: rgba(200, 170, 100, 0.3);
}

.gate-input:focus {
  border-color: rgba(232, 197, 109, 0.7);
  box-shadow: 0 0 20px rgba(232, 197, 109, 0.2), inset 0 0 20px rgba(232, 197, 109, 0.05);
}

.gate-input.is-wrong {
  border-color: rgba(255, 100, 100, 0.7);
  box-shadow: 0 0 20px rgba(255, 80, 80, 0.3);
  animation: gate-shake 0.5s ease;
}

.gate-submit {
  height: 48px;
  padding: 0 28px;
  background: linear-gradient(135deg, rgba(200, 155, 70, 0.9), rgba(180, 130, 50, 0.8));
  color: #0b1335;
  border: none;
  border-radius: 24px;
  font-size: 15px;
  font-family: "Noto Serif SC", serif;
  font-weight: 600;
  cursor: pointer;
  letter-spacing: 4px;
  transition: all 0.3s;
  box-shadow: 0 0 20px rgba(200, 155, 70, 0.2);
}

.gate-submit:hover {
  background: linear-gradient(135deg, rgba(220, 175, 90, 0.95), rgba(200, 150, 70, 0.85));
  box-shadow: 0 0 30px rgba(200, 155, 70, 0.35);
  transform: translateY(-1px);
}

.gate-submit:active {
  transform: translateY(0);
}

.gate-submit:disabled {
  opacity: 0.5;
  cursor: default;
}

.gate-hint {
  min-height: 26px;
  text-align: center;
  margin-bottom: 18px;
}

.gate-hint-text {
  font-size: 13px;
  color: rgba(180, 200, 230, 0.7);
  opacity: 0;
  transition: opacity 0.3s;
  letter-spacing: 1px;
}

.gate-hint-text.is-visible {
  opacity: 1;
}

.gate-hint-text.is-wrong {
  color: rgba(255, 140, 140, 0.9);
}

.gate-footer {
  font-size: 12px;
  color: rgba(180, 200, 230, 0.35);
  letter-spacing: 10px;
}

@keyframes gate-shake {
  0%, 100% { transform: translateX(0); }
  10%, 50%, 90% { transform: translateX(-5px); }
  30%, 70% { transform: translateX(5px); }
}

@media (max-width: 767px) {
  .gate-container {
    padding: 36px 20px 32px;
  }
  .gate-portal-ring {
    width: 300px;
    height: 300px;
  }
  .gate-question-text {
    font-size: 18px;
    letter-spacing: 2px;
  }
  .gate-input {
    width: 130px;
    height: 42px;
    font-size: 17px;
  }
  .gate-submit {
    height: 42px;
    padding: 0 20px;
    font-size: 14px;
  }
  .gate-constellation {
    width: 48px;
    height: 48px;
    margin-bottom: 24px;
  }
  .gate-footer {
    letter-spacing: 6px;
  }
}
@media (max-width: 767px) {
  .random-posts-list {
    gap: 4px;
  }
  .random-post-item {
    padding: 8px 12px;
    font-size: 13px;
  }
}
